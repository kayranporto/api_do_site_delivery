# Gere um valor aleatório de pelo menos 32 caracteres antes de executar.
API_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Origens do navegador separadas por vírgula. Vazio = nenhuma origem CORS permitida.
CORS_ORIGINS=http://localhost:5173
# Rate limiting local por IP nas rotas /api/v1.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Configurações sem credenciais. Segredos devem usar env:VARIABLE_NAME.
PROVIDER_CONFIG_JSON={}
# Opcional em desenvolvimento. Ao configurar, o servidor usará PostgreSQL persistente.
# Execute npm run db:migrate explicitamente antes de iniciar a API.
# DATABASE_URL=postgresql://user:password@localhost:5432/generic_integration_api
DATABASE_POOL_MAX=10

# Worker em processo separado (requer DATABASE_URL e migration atualizada).
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_STALE_BATCH_SIZE=50
WORKER_STALE_AFTER_MS=300000
WORKER_LEASE_MS=180000

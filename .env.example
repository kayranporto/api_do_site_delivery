# Credencial master administrativa. Nunca a entregue aos consumidores da API.
# Gere um valor aleatório de pelo menos 32 caracteres antes de executar.
API_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Origens do navegador separadas por vírgula. Vazio = nenhuma origem CORS permitida.
CORS_ORIGINS=http://localhost:5173

# Rate limits em janelas fixas.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Desenvolvimento: memória local. Produção exige RATE_LIMIT_STORE=upstash.
RATE_LIMIT_STORE=memory
# Configure os valores reais no cofre de segredos da implantação:
# RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-a-secret-rest-token

# Observabilidade HTTP por instância e regras de alerta.
OBSERVABILITY_WINDOW_MINUTES=5
ALERT_MIN_REQUESTS=20
ALERT_P95_LATENCY_MS=1000
ALERT_ERROR_RATE_PERCENT=5
ALERT_429_RATE_PERCENT=20
ALERT_RSS_MB=512
# Prometheus scrape: token distinto da credencial master (obrigatório em produção).
# METRICS_ACCESS_TOKEN=replace-with-a-separate-random-secret-at-least-32-characters
# Notificações proativas são opcionais; webhook HTTPS em produção.
# ALERT_WEBHOOK_URL=https://alerts.example.com/api/webhooks/your-endpoint
# ALERT_WEBHOOK_TOKEN=optional-bearer-secret
ALERT_NOTIFICATION_INTERVAL_MS=60000
ALERT_NOTIFICATION_COOLDOWN_MS=300000

# Configurações sem credenciais. Segredos devem usar env:VARIABLE_NAME.
PROVIDER_CONFIG_JSON={}
# Opcional em desenvolvimento. Em produção, PostgreSQL é obrigatório.
# Execute npm run db:migrate explicitamente antes de iniciar a API.
# DATABASE_URL=postgresql://user:password@localhost:5432/generic_integration_api
DATABASE_POOL_MAX=10

# Worker em processo separado (requer DATABASE_URL e migration atualizada).
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_STALE_BATCH_SIZE=50
WORKER_STALE_AFTER_MS=300000
WORKER_LEASE_MS=180000
